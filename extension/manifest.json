{
  "manifest_version": 3,
  "name": "همکار — Hamkar",
  "version": "0.4.0",
  "description": "فضای کاری تیمی در تب جدید: تیم، پروژه، فاز، نسخه، تسک، اسکیل، جلسه آنلاین و چت",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://apps.webiro.ir/*",
    "http://apps.webiro.ir/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
