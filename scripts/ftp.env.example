# Hamkar FTP sync credentials — copy to ftp.env and fill in.
# ftp.env is git-ignored; never commit real credentials.

FTP_HOST=ftp.example.com
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# Remote folder that maps to server/ (the hamkar folder on your host)
FTP_REMOTE_DIR=/apps.webiro.ir/hamkar

# yes = FTPS (explicit TLS). Set to "no" only if your host has no TLS.
FTP_SECURE=yes
