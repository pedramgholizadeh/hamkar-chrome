# Hamkar FTP deploy credentials — copy to ftp.env and fill in.
# ftp.env is git-ignored; never commit real credentials.

FTP_HOST=ftp.example.com
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PORT=21

# Remote folder that maps to server/ — if your FTP account lands directly
# inside the hamkar folder, keep it as /
FTP_REMOTE_DIR=/

# true = passive mode (works behind NAT/firewalls)
FTP_PASSIVE=true
